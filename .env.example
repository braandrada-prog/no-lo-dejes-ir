# Copiá este archivo a `.env` (local) y cargá los mismos nombres en Vercel.
# Las variables VITE_* se incrustan en el bundle del navegador: solo valores PÚBLICOS.
# Nunca pongas aquí la service_role key ni tokens de Mercado Pago.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Secretos de las Edge Functions (NO van en Vercel ni en este archivo):
# se cargan con `supabase secrets set NOMBRE=valor`.
#   MP_WEBHOOK_SECRET_TEST, MP_WEBHOOK_SECRET_PROD
#   MP_ACCESS_TOKEN_TEST,   MP_ACCESS_TOKEN_PROD
#   MP_CLIENT_ID_TEST,      MP_CLIENT_SECRET_TEST
#   MP_CLIENT_ID_PROD,      MP_CLIENT_SECRET_PROD
#   MP_OAUTH_REDIRECT_URI, MP_OAUTH_PKCE, MP_TOKEN_ENC_KEY
#   NLID_TASK_TOKEN, APP_URL
#   MP_WEBHOOK_TOLERANCE_SECONDS   (opcional, por defecto 600)
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.
